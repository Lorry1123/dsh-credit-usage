{
  "name": "@local/dsh-credit-usage",
  "version": "0.1.0",
  "private": true,
  "description": "Show weekly Codex and Claude limits and the DeepSeek balance in the DSH sidebar.",
  "type": "module",
  "scripts": { "test": "node --test" },
  "engines": { "dsh": "0.2.2-rc.5" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "cli-usage.js", "balance.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
